<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="LaptopContainer" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.7); justify-content: center; align-items: center; width: 100%; height: 100%; position: absolute; display: none;">
        
        <ui:VisualElement style="width: 1200px; height: 800px; background-color: rgb(30, 30, 40); border-radius: 15px; overflow: hidden; border-width: 5px; border-color: rgb(50, 50, 60);">
            
            <!-- РАБОЧИЙ СТОЛ -->
            <ui:VisualElement name="DesktopView" style="flex-grow: 1; background-color: rgb(41, 128, 185); padding: 40px; flex-direction: row; align-content: flex-start; flex-wrap: wrap;">
                <ui:Button name="Btn_ShopApp" text="Каталог&#10;" style="width: 120px; height: 120px; background-color: rgba(0,0,0,0.3); color: white; border-radius: 15px; border-width: 0; font-size: 16px; -unity-font-style: bold; margin-right: 20px;" />
                <ui:Button name="Btn_StatusApp" text="Состояние&#10;Сборки" style="width: 120px; height: 120px; background-color: rgba(0,0,0,0.3); color: white; border-radius: 15px; border-width: 0; font-size: 16px; -unity-font-style: bold; margin-right: 20px;" />
                <ui:Button name="Btn_QuestApp" text="Биржа&#10;PC Master" style="width: 120px; height: 120px; background-color: rgb(243, 156, 18); color: white; border-radius: 15px; border-width: 0; font-size: 16px; -unity-font-style: bold;" />
            </ui:VisualElement>

            <!-- ОКНО СТАТУСА (СТАРОЕ) -->
            <ui:VisualElement name="StatusView" style="flex-grow: 1; background-color: rgb(236, 240, 241); display: none;">
                <ui:VisualElement style="height: 50px; background-color: rgb(189, 195, 199); flex-direction: row; align-items: center; padding-left: 20px;">
                    <ui:Button name="Btn_CloseStatus" text="X" style="width: 40px; height: 40px; background-color: rgb(231, 76, 60); color: white; border-radius: 5px; border-width: 0; -unity-font-style: bold;" />
                    <ui:Label text="Диагностика системы" style="font-size: 20px; color: black; -unity-font-style: bold; margin-left: 20px;" />
                </ui:VisualElement>
                <ui:ScrollView style="flex-grow: 1; padding: 30px;">
                    <ui:Label name="Txt_SystemStats" text="Загрузка..." style="font-size: 24px; color: rgb(44, 62, 80); white-space: normal;" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- НОВОЕ ОКНО: БИРЖА ЗАКАЗОВ -->
            <ui:VisualElement name="QuestView" style="flex-grow: 1; background-color: rgb(236, 240, 241); display: none; flex-direction: column;">
                <ui:VisualElement style="height: 50px; background-color: rgb(243, 156, 18); flex-direction: row; align-items: center; padding-left: 20px; justify-content: space-between; padding-right: 20px;">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Button name="Btn_CloseQuest" text="X" style="width: 40px; height: 40px; background-color: rgb(231, 76, 60); color: white; border-radius: 5px; border-width: 0; -unity-font-style: bold;" />
                        <ui:Label text="Биржа заказов (Профиль мастера)" style="font-size: 20px; color: white; -unity-font-style: bold; margin-left: 20px;" />
                    </ui:VisualElement>
                    <ui:Label name="Txt_GlobalRating" text="Рейтинг: 5.0 ⭐" style="font-size: 20px; color: white; -unity-font-style: bold;" />
                </ui:VisualElement>

                <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                    <!-- Левая колонка: Профиль и История -->
                    <ui:VisualElement style="width: 350px; border-right-width: 1px; border-color: gray; padding: 20px;">
                        <ui:Label text="ИСТОРИЯ ЗАКАЗОВ" style="font-size: 18px; -unity-font-style: bold; margin-bottom: 15px;" />
                        <ui:ScrollView name="HistoryScroll" style="flex-grow: 1;" />
                    </ui:VisualElement>

                    <!-- Правая колонка: Текущий заказ -->
                    <ui:VisualElement style="flex-grow: 1; padding: 30px; align-items: center; justify-content: center;">
                        <ui:Label name="Txt_ActiveQuestTitle" text="Нет активных заказов" style="font-size: 28px; -unity-font-style: bold; margin-bottom: 20px;" />
                        <ui:Label name="Txt_ActiveQuestDesc" text="Нажмите 'Найти заказ', чтобы получить работу." style="font-size: 18px; white-space: normal; margin-bottom: 40px; width: 80%;" />
                        
                        <ui:Button name="Btn_AcceptQuest" text="НАЙТИ ЗАКАЗ" style="width: 250px; height: 60px; font-size: 20px; background-color: rgb(46, 204, 113); color: white; border-radius: 10px;" />
                        <ui:Button name="Btn_CompleteQuest" text="СДАТЬ РАБОТУ КЛИЕНТУ" style="width: 250px; height: 60px; font-size: 20px; background-color: rgb(52, 152, 219); color: white; border-radius: 10px; display: none;" />
                        <ui:Label name="Txt_QuestFeedback" text="" style="font-size: 18px; color: red; margin-top: 20px; -unity-font-style: bold; white-space: normal;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>